{
  "name": "lit-browser",
  "productName": "Lit",
  "version": "0.1.0",
  "description": "Lit, a minimal Chromium browser",
  "main": "src/main.js",
  "scripts": {
    "start": "LIT_FOREGROUND=1 electron .",
    "dev": "LIT_FOREGROUND=1 node --watch-path=src node_modules/electron/cli.js .",
    "native": "node-gyp rebuild --directory native",
    "build": "npm run native && electron-builder",
    "build:signed": "npm run native && electron-builder --config build/signed.config.js",
    "app": "sh scripts/install-app.sh",
    "test": "node --test"
  },
  "build": {
    "appId": "app.jimmywu.lit",
    "directories": { "output": "out" },
    "files": ["src/**/*", "native/build/Release/passkeys.node"],
    "asarUnpack": ["native/build/Release/passkeys.node"],
    "mac": {
      "target": "dir",
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Web site URL",
            "CFBundleTypeRole": "Viewer",
            "CFBundleURLSchemes": ["http", "https"]
          }
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "HTML document",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["public.html", "public.xhtml"]
          },
          {
            "CFBundleTypeName": "PDF document",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["com.adobe.pdf"]
          }
        ]
      }
    }
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "tldts": "^7.6.2"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "node-gyp": "^12.4.0"
  },
  "private": true
}
